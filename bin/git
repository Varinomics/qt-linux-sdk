#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "$(readlink -f -- "$0")")/../activate.sh"
export GIT_EXEC_PATH="$SDK_ROOT/support/usr/lib/git-core"
export GIT_TEMPLATE_DIR="$SDK_ROOT/support/usr/share/git-core/templates"
if [[ -f "$SDK_ROOT/support/etc/ssl/certs/ca-certificates.crt" ]]; then
    export GIT_SSL_CAINFO="$SDK_ROOT/support/etc/ssl/certs/ca-certificates.crt"
fi
exec "$SDK_ROOT/support/usr/bin/git" "$@"
